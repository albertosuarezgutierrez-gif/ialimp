# Base de datos Supabase
DATABASE_URL="postgresql://prisma_user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://prisma_user:password@host:5432/postgres"

# JWT para sesiones de empresa
JWT_SECRET="cambia-esto-por-algo-seguro-en-produccion"

# URL pública de la app (producción = dominio propio). Usada para enlaces
# absolutos en emails, redirects de Stripe y llamadas servidor→servidor.
# NEXTAUTH_URL tiene prioridad; si falta, se usa NEXT_PUBLIC_APP_URL; fallback = ialimp.es.
NEXTAUTH_URL="https://ialimp.es"
NEXT_PUBLIC_APP_URL="https://ialimp.es"
